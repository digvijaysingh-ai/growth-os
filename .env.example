# Copy to .env (git-ignored) and fill in yourself.

# Meta Marketing API: a System User token from Business Settings with ads_read
# (and ads_management, only needed to carry out pauses you approved).
META_ACCESS_TOKEN=
# the ad account id, with or without the act_ prefix
META_AD_ACCOUNT_ID=
META_API_VERSION=v23.0

# your site's agent endpoint and the agent_token from its private config.php
SITE_AGENT_URL=https://example.com/api/agent.php
SITE_AGENT_TOKEN=

# optional: Claude writes the report summary. Without it, an `ant auth login` profile also works.
# ANTHROPIC_API_KEY=

# optional: Slack incoming webhook for the weekly memo and ad proposals
# SLACK_WEBHOOK_URL=
