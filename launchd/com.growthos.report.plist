<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- growth-os report. Replace REPO with the absolute path of this repo, copy to ~/Library/LaunchAgents/, then:
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.growthos.report.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.growthos.report</string>
  <key>ProgramArguments</key><array><string>REPO/.venv/bin/growth-os</string><string>report</string></array>
  <key>WorkingDirectory</key><string>REPO</string>
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>REPO/state/report.log</string>
  <key>StandardErrorPath</key><string>REPO/state/report.log</string>
</dict>
</plist>
